end

local function refGrip()
	return CFrame.new(GRIP_POS * SCALE)
		* CFrame.Angles(math.rad(90), 0, 0)
		* CFrame.Angles(math.rad(GRIP_ROT_DEG.X), math.rad(GRIP_ROT_DEG.Y), math.rad(GRIP_ROT_DEG.Z))
end

local function newEmitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.Enabled = false
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = parent
	return e
end

local function fade(a, b)
