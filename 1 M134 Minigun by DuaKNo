local function makeHole(result)
	local hit = result.Instance
	if not hit or hit.Transparency > 0.9 then return end

	local hole = Instance.new("Part")
	hole.Name = "BulletHole"
	hole.Anchored = false
	hole.CanCollide = false
	hole.CanQuery = false
	hole.CanTouch = false
	hole.Massless = true
	hole.CastShadow = false
	hole.Material = Enum.Material.SmoothPlastic
	hole.TopSurface = Enum.SurfaceType.Smooth
	hole.BottomSurface = Enum.SurfaceType.Smooth

	local normal = result.Normal
	local pos = result.Position + normal * 0.012
	local base = CFrame.lookAt(pos, pos + normal)

	if HOLE_TEXTURE ~= "" then
		hole.Size = Vector3.new(0.5, 0.5, 0.02)
		hole.Transparency = 1
		hole.CFrame = base * CFrame.Angles(0, 0, math.rad(math.random(0, 359)))
		local d = Instance.new("Decal")
		d.Texture = HOLE_TEXTURE
		d.Face = Enum.NormalId.Front
		d.Parent = hole
	else
		local s = 0.22 + math.random() * 0.12
		hole.Shape = Enum.PartType.Cylinder
		hole.Size = Vector3.new(0.015, s, s)
		hole.Color = Color3.fromRGB(12, 12, 12)
		hole.CFrame = base * CFrame.Angles(0, math.rad(90), 0)

		local ring = hole:Clone()
		ring.Name = "Scorch"
		ring.Size = Vector3.new(0.01, s * 2.1, s * 2.1)
		ring.Color = hit.Color:Lerp(Color3.new(0, 0, 0), 0.65)
		ring.Transparency = 0.45
		ring.CFrame = hole.CFrame * CFrame.new(-0.002, 0, 0)
		ring.Parent = bulletFolder
		local rw = Instance.new("WeldConstraint")
		rw.Part0, rw.Part1 = ring, hit
		rw.Parent = ring
		Debris:AddItem(ring, HOLE_LIFETIME + 1)
		TweenService:Create(ring, TweenInfo.new(2, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, HOLE_LIFETIME - 2), {Transparency = 1}):Play()
	end

	hole.Parent = bulletFolder
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = hole, hit
	w.Parent = hole

	table.insert(holes, hole)
	if #holes > MAX_HOLES then
		local o = table.remove(holes, 1)
		if o then o:Destroy() end
	end
	Debris:AddItem(hole, HOLE_LIFETIME + 1)
	if hole.Transparency < 1 then
		TweenService:Create(hole, TweenInfo.new(2, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, HOLE_LIFETIME - 2), {Transparency = 1}):Play()
	end
end

local fxList = {}

local function rand(a, b) return a + math.random() * (b - a) end

local function newFx(size, color, shape, material)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	if shape then p.Shape = shape end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

local function throwPiece(part, pos, vel, life, gravity, stretch, spin)
	part.CFrame = CFrame.new(pos)
	part.Parent = bulletFolder
	table.insert(fxList, {
		part = part, pos = pos, vel = vel, life = life, age = 0, g = gravity,
		stretch = stretch, spin = spin or Vector3.zero, rot = CFrame.new(), size = part.Size,
	})
end

RunService.Heartbeat:Connect(function(dt)
	for i = #fxList, 1, -1 do
		local f = fxList[i]
		f.age += dt
		if f.age >= f.life or not f.part.Parent then
			f.part:Destroy()
			table.remove(fxList, i)
		else
			f.vel += Vector3.new(0, -f.g, 0) * dt
			f.vel *= (1 - 1.2 * dt)
			f.pos += f.vel * dt
			local t = f.age / f.life
			if f.stretch then
				local len = math.clamp(f.vel.Magnitude * 0.035, 0.15, 1.6)
				f.part.Size = Vector3.new(f.size.X, f.size.Y, len)
				if f.vel.Magnitude > 0.1 then
					f.part.CFrame = CFrame.lookAt(f.pos, f.pos + f.vel)
				end
			else
				f.rot = f.rot * CFrame.Angles(f.spin.X * dt, f.spin.Y * dt, f.spin.Z * dt)
				f.part.CFrame = CFrame.new(f.pos) * f.rot
			end
			f.part.Transparency = t * t
		end
	end
end)

