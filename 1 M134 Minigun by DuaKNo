local function rigOf(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then return "R15" end
	return "R6"
end

local function armPose(a)
	return CFrame.Angles(math.rad(a.pitch), 0, math.rad(a.swing))
end

local function rotatedAbout(c0, rot)
	local p = c0.Position
	return CFrame.new(p) * rot * CFrame.new(-p) * c0
end

local function findMotor(char, names)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Motor6D") and names[d.Name] then
