local flingUntil = {}

local function findNpc(inst)
	local m = inst
	while m and m ~= workspace do
		if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then
			if Players:GetPlayerFromCharacter(m) and not FLING_PLAYERS then return nil end
			return m
		end
		m = m.Parent
	end
	return nil
end

local function flingNpc(model, dir)
	local vel = dir.Unit * FLING_SPEED

	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum.PlatformStand = true
			hum:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end

	local already = flingUntil[model] ~= nil
	flingUntil[model] = os.clock() + FLING_TIME
	if already then return end

	task.spawn(function()
		while model.Parent and os.clock() < flingUntil[model] do
			for _, part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") and not part.Anchored then
					part.AssemblyLinearVelocity = vel
					part.AssemblyAngularVelocity = Vector3.new(rand(-20, 20), rand(-20, 20), rand(-20, 20))
				end
			end
			RunService.Heartbeat:Wait()
		end
		flingUntil[model] = nil
		if hum and hum.Parent then pcall(function() hum.PlatformStand = false end) end
	end)
end

local function flingPart(part, dir)
	if part.Anchored then return end
	local root = part.AssemblyRootPart or part
	if root.Anchored then return end
	local vel = dir.Unit * FLING_SPEED

	local already = flingUntil[root] ~= nil
	flingUntil[root] = os.clock() + FLING_TIME
	if already then return end

	task.spawn(function()
		while root.Parent and os.clock() < flingUntil[root] do
			local list = {root}
			local ok, connected = pcall(function() return root:GetConnectedParts(true) end)
			if ok then list = connected end
			for _, p in ipairs(list) do
				if not p.Anchored then
					p.AssemblyLinearVelocity = vel
					p.AssemblyAngularVelocity = Vector3.new(rand(-20, 20), rand(-20, 20), rand(-20, 20))
				end
			end
			RunService.Heartbeat:Wait()
		end
		flingUntil[root] = nil
	end)
end

