local dbgLabel
local lastDbg = 0
local function debugUpdate(force)
	if not (DEBUG or ARM_DEBUG) then return end
	local now = os.clock()
	if not force and now - lastDbg < 0.2 then return end
	lastDbg = now
	if not (dbgLabel and dbgLabel.Parent) then
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if not pg then return end
		local g = Instance.new("ScreenGui")
		g.Name = "M134Debug"
		g.ResetOnSpawn = false
		g.IgnoreGuiInset = true
		g.Parent = pg
		dbgLabel = Instance.new("TextLabel")
		dbgLabel.BackgroundTransparency = 0.5
		dbgLabel.BackgroundColor3 = Color3.new(0, 0, 0)
		dbgLabel.TextColor3 = Color3.new(1, 1, 1)
		dbgLabel.TextXAlignment = Enum.TextXAlignment.Left
		dbgLabel.Font = Enum.Font.Code
		dbgLabel.TextSize = 14
		dbgLabel.Position = UDim2.fromOffset(10, 40)
		dbgLabel.Size = UDim2.fromOffset(330, 70)
		dbgLabel.TextWrapped = true
		dbgLabel.Parent = g
	end
	dbgLabel.Text = ("M134  shots %d  hits %d\narms: %s  resets %d%s"):format(stats.shots, stats.hits, stats.arm, stats.resets, stats.err ~= "" and ("\nERR: " .. stats.err) or "")
end

local function fireShot(origin, dir, params)
	stats.shots += 1
	local res = workspace:Raycast(origin, dir * RANGE, params)
	local endPos = res and res.Position or (origin + dir * RANGE)
	local dist = (endPos - origin).Magnitude

	local len = math.min(dist, 2040)
	local line = newFx(Vector3.new(BEAM_THICKNESS, BEAM_THICKNESS, len), BEAM_COLOR)
	line.CFrame = CFrame.lookAt(origin, endPos) * CFrame.new(0, 0, -len / 2)
	line.Parent = bulletFolder
	TweenService:Create(line, TweenInfo.new(BEAM_FADE_TIME, Enum.EasingStyle.Quad), {Transparency = 1}):Play()
	Debris:AddItem(line, BEAM_FADE_TIME + 0.05)

	for _ = 1, 3 do
		local sp = newFx(Vector3.new(0.1, 0.1, 0.5), Color3.fromRGB(255, math.random(170, 230), 80))
		local d = (dir + Vector3.new(rand(-0.35, 0.35), rand(-0.35, 0.35), rand(-0.35, 0.35))).Unit
		throwPiece(sp, origin, d * rand(20, 45), rand(0.15, 0.3), 30, true)
	end

	if res then
		stats.hits += 1
		local ok, err = pcall(impactEffect, res)
		if not ok then stats.err = tostring(err); debugUpdate(true) end
		local npc = findNpc(res.Instance)
		if npc then
			local ok2, err2 = pcall(flingNpc, npc, dir)
			if not ok2 then stats.err = tostring(err2); debugUpdate(true) end
		else
			local m = res.Instance:FindFirstAncestorOfClass("Model")
			local isPlayerChar = m and Players:GetPlayerFromCharacter(m) ~= nil
			if not isPlayerChar and res.Instance:IsA("BasePart") and not res.Instance.Anchored then
				local ok3, err3 = pcall(flingPart, res.Instance, dir)
				if not ok3 then stats.err = tostring(err3); debugUpdate(true) end
			end
		end
	end
	debugUpdate()
end

local function makeSounds(handle)
	local s = {}
	for name, id in pairs(SOUND_IDS) do
		local snd = Instance.new("Sound")
		snd.Name = name
		snd.SoundId = "rbxassetid://" .. id
		snd.Volume = VOLUME[name]
		snd.Looped = (name == "fire" or name == "windLoop")
		snd.RollOffMaxDistance = 150
		snd.Parent = handle
		s[name] = snd
	end
	return s
end

local function checkSounds(sounds)
	task.spawn(function()
		local list = {}
		for _, s in pairs(sounds) do table.insert(list, s) end
		pcall(function() ContentProvider:PreloadAsync(list) end)
		for name, s in pairs(sounds) do
			if s.TimeLength == 0 then
				warn(("[M134] '%s' (%s) did not load. The audio is probably private or not usable in this game."):format(name, s.SoundId))
			end
		end
	end)
end

local function setupWeapon(tool)
	local handle = tool:WaitForChild("Handle")
	local sounds = makeSounds(handle)
	checkSounds(sounds)

	local att = Instance.new("Attachment")
	att.Name = "Muzzle"
	att.Position = MUZZLE_OFFSET
	att.Parent = handle

	local light = Instance.new("PointLight")
	light.Color = BULLET_COLOR
	light.Range = 12
	light.Brightness = 4
	light.Enabled = false
	light.Parent = att

	local muzzleSmoke = newEmitter(att, {
		Texture = SMOKE_TEXTURE,
		Color = ColorSequence.new(Color3.fromRGB(190, 190, 190)),
		Size = fade(0.3, 1.8),
		Transparency = fade(0.55, 1),
		Lifetime = NumberRange.new(0.7, 1.3),
		Speed = NumberRange.new(3, 7),
		SpreadAngle = Vector2.new(12, 12),
		Acceleration = Vector3.new(0, 2.5, 0),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-40, 40),
		Rate = 35,
	})

	local firing = false
	local soundToken = 0
	local charging, chargeId = false, 0
	local savedSpeed, slowHum

	local function restoreSpeed()
		if slowHum and slowHum.Parent and savedSpeed then
			slowHum.WalkSpeed = savedSpeed
		end
		savedSpeed, slowHum = nil, nil
	end
	local held = {tool = false, btn = false}

	local function aimDirection(origin, params)
		local cam = workspace.CurrentCamera
		if not cam then return handle.CFrame.UpVector end
		local vp = cam.ViewportSize
		local pt
		if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			pt = Vector2.new(vp.X / 2, vp.Y / 2)
		else
			pt = UserInputService:GetMouseLocation()
		end
		local ray = cam:ViewportPointToRay(pt.X, pt.Y)
		local res = workspace:Raycast(ray.Origin, ray.Direction * 1500, params)
		local target = res and res.Position or (ray.Origin + ray.Direction * 1500)
		local d = target - origin
		if d.Magnitude < 1 then return ray.Direction end
		local dir = d.Unit
		if dir:Dot(ray.Direction) < 0.2 then return ray.Direction end
		return dir
	end

	local function shoot(params)
		local cf = handle.CFrame
		local origin = cf:PointToWorldSpace(MUZZLE_OFFSET)
		local s = math.rad(BULLET_SPREAD_DEG)
		local aim = CFrame.lookAt(Vector3.zero, aimDirection(origin, params))
			* CFrame.Angles((math.random() - 0.5) * 2 * s, (math.random() - 0.5) * 2 * s, 0)
		fireShot(origin, aim.LookVector, params)
		muzzleFlash(origin, aim.LookVector)
		light.Enabled = true
		task.delay(0.04, function() light.Enabled = false end)
	end

	local function stopFiring()
		if not firing then return end
		firing = false
		restoreSpeed()
		muzzleSmoke.Enabled = false
		sounds.fire:Stop()
		sounds.windUp:Stop()
		soundToken += 1
		sounds.windLoop:Stop()
		sounds.shutdown:Play()
	end

	local function startFiring()
		if firing then return end
		local char = tool.Parent
		if not (char and char:IsA("Model")) then return end
		firing = true

		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and not slowHum then
			savedSpeed = hum.WalkSpeed
			slowHum = hum
			hum.WalkSpeed = savedSpeed * (1 - FIRE_SLOW)
		end

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {char, bulletFolder}

		soundToken += 1
		sounds.windLoop:Stop()
		sounds.shutdown:Stop()
		sounds.windUp:Stop()
		sounds.fire:Play()
		muzzleSmoke.Enabled = true
		task.spawn(function()
			while firing and tool.Parent == char do
				local ok, err = pcall(shoot, params)
				if not ok then stats.err = tostring(err); debugUpdate(true) end
				task.wait(1 / FIRE_RATE)
			end
		end)
	end

	local function beginCharge()
		if firing or charging then return end
		charging = true
		chargeId += 1
		local my = chargeId
		soundToken += 1
		sounds.windLoop:Stop()
		sounds.shutdown:Stop()
		sounds.windUp:Play()
		local dur = sounds.windUp.TimeLength
		if dur <= 0 then dur = CHARGE_TIME end
		dur = math.min(dur, CHARGE_MAX)
		task.delay(dur, function()
			if chargeId ~= my or not charging then return end
			charging = false
			if (held.tool or held.btn) and tool.Parent and tool.Parent:IsA("Model") then
				startFiring()
			end
		end)
	end

	local function refresh()
		if held.tool or held.btn then
			if tool.Parent and tool.Parent:IsA("Model") then beginCharge() end
		else
			if charging then
				charging = false
				chargeId += 1
				sounds.windUp:Stop()
			end
			stopFiring()
		end
	end

	local rmbConn1, rmbConn2
	local function bindMouse()
		if rmbConn1 then return end
		rmbConn1 = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				held.tool = true
				refresh()
			end
		end)
		rmbConn2 = UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				held.tool = false
				refresh()
			end
		end)
	end
	local function unbindMouse()
		if rmbConn1 then rmbConn1:Disconnect(); rmbConn1 = nil end
		if rmbConn2 then rmbConn2:Disconnect(); rmbConn2 = nil end
		held.tool = false
	end

	local ACTION = "M134Fire"
	local bound = false
	local function showButton()
		if bound or not UserInputService.TouchEnabled then return end
		bound = true
		ContextActionService:BindAction(ACTION, function(_, state)
			if state == Enum.UserInputState.Begin then
				held.btn = true
				refresh()
			elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				held.btn = false
				refresh()
			end
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.ButtonR2)
		ContextActionService:SetTitle(ACTION, "FIRE")
		ContextActionService:SetPosition(ACTION, UDim2.new(1, -110, 1, -170))
	end
	local function hideButton()
		held.btn = false
		if bound then
			bound = false
			ContextActionService:UnbindAction(ACTION)
		end
	end

	tool.Equipped:Connect(function() showButton(); bindMouse() end)
	tool.Unequipped:Connect(function() hideButton(); unbindMouse(); refresh() end)
	if tool.Parent and tool.Parent:IsA("Model") then showButton(); bindMouse() end

	return function()
		held.tool, held.btn = false, false
		firing, charging = false, false
		chargeId += 1
		restoreSpeed()
		for _, snd in pairs(sounds) do snd:Stop() end
		light.Enabled = false
		muzzleSmoke.Enabled = false
		hideButton()
		unbindMouse()
	end
end

local active = {}

local maintainClean

local function release()
	if maintainClean then maintainClean(); maintainClean = nil end
	for _, a in ipairs(active) do
		if a.weld then a.weld:Destroy() end
		if a.motor and a.motor.Parent then a.motor.Part1 = a.part1 end
	end
	table.clear(active)
end

local function takeOver(motor)
	if not (motor and motor.Part0 and motor.Part1) then return nil end
	local w = Instance.new("Weld")
	w.Name = "MinigunPose"
	w.Part0 = motor.Part0
	w.Part1 = motor.Part1
	w.C0 = motor.C0
	w.C1 = motor.C1
	w.Parent = motor.Part0
	table.insert(active, {motor = motor, part1 = motor.Part1, weld = w})
	motor.Part1 = nil
	return w
end

local function getRig(char, side)
	local shoulder = findMotor(char, {[side .. " Shoulder"] = true, [side .. "Shoulder"] = true})
	if not shoulder then return nil end
	local chain = {}
	local elbow = findMotor(char, {[side .. "Elbow"] = true})
	local wrist = findMotor(char, {[side .. "Wrist"] = true})
	if elbow then table.insert(chain, elbow) end
	if wrist then table.insert(chain, wrist) end
	local rel = CFrame.new()
	for _, m in ipairs(chain) do
		rel = rel * m.C0 * m.C1:Inverse()
	end
	return {shoulder = shoulder, chain = chain, rel = rel}
end

local function placeArm(rig, weld, target, attachPos, extra)
	local sh = rig.shoulder
	local pivot = sh.C0.Position
	local handOff = rig.rel:PointToWorldSpace(attachPos)
	local reach = (handOff - sh.C1.Position).Magnitude

	local v = target - pivot
	local dist = v.Magnitude
	if dist < 0.05 then v = Vector3.new(0, 0, -1); dist = 1 end
	local dir = v / dist
	if dist > reach + MAX_STRETCH then
		target = pivot + dir * (reach + MAX_STRETCH)
	end

	local R = CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(math.rad(90), 0, 0)
	if extra then R = R * extra end
	local AF = CFrame.new(target - R:VectorToWorldSpace(handOff)) * R
	weld.C0 = AF * sh.C1
	return AF
end

local function gunCFrame(P, base)
	if not STRAIGHT_GUN then
		return CFrame.new(P.gun) * base
	end
	local p = GRIP_POS * SCALE
	local pivot = base * p
	local t = P.tilt
	local tilt = CFrame.Angles(math.rad(t.X), math.rad(t.Y), math.rad(t.Z))
	return CFrame.new(P.gun) * CFrame.new(pivot) * tilt * STRAIGHT_ROT * CFrame.new(-p)
end

local function applyArms(c)
	local P = c.P
	local h = gunCFrame(P, c.base)

	local AFr = placeArm(c.R, c.rW, h * (P.right * SCALE), c.rAttach.Position)
	local grip = h:Inverse() * (AFr * c.R.rel * c.rAttach)
	c.tool.Grip = grip
	c.gripWeld.C1 = grip

	local lt = P.leftTilt
	local leftTilt = CFrame.Angles(math.rad(lt.X), math.rad(lt.Y), math.rad(lt.Z))
	placeArm(c.L, c.lW, h * (P.left * SCALE), c.lAttach, leftTilt)
end

local function buildCtx(char, tool, P)
	local gripWeld = char:FindFirstChild("RightGrip", true)
	if not gripWeld then return nil, "no RightGrip" end

	local R = getRig(char, "Right")
	local L = getRig(char, "Left")
	if not R then return nil, "no Right Shoulder motor" end
	if not L then return nil, "no Left Shoulder motor" end

	local refAF = rotatedAbout(R.shoulder.C0, armPose(REF_RIGHT)) * R.shoulder.C1:Inverse()
	local base  = refAF * R.rel * gripWeld.C0 * refGrip():Inverse()

	local lAttach = Vector3.new(0, -1, 0)
	local att = char:FindFirstChild("LeftGripAttachment", true)
	if att then lAttach = att.Position end

	for _, m in ipairs(R.chain) do takeOver(m) end
	for _, m in ipairs(L.chain) do takeOver(m) end
	local rW = takeOver(R.shoulder)
	local lW = takeOver(L.shoulder)
	if not (rW and lW) then
		release()
		return nil, "takeOver failed (shoulder Part0/Part1 missing)"
	end

	return {
		P = P, tool = tool, R = R, L = L, rW = rW, lW = lW,
		base = base, gripWeld = gripWeld,
		rAttach = gripWeld.C0, lAttach = lAttach,
	}
end

local function buildCtxR15(char, tool, P)
	local gripWeld = char:FindFirstChild("RightGrip", true)
	if not gripWeld then return nil, "no RightGrip" end
	local R = getRig(char, "Right")
	local L = getRig(char, "Left")
	if not R then return nil, "no RightShoulder motor" end
	if not L then return nil, "no LeftShoulder motor" end

	local refAF = rotatedAbout(R.shoulder.C0, armPose(REF_RIGHT)) * R.shoulder.C1:Inverse()
	local base  = refAF * R.rel * gripWeld.C0 * refGrip():Inverse()

	local lAttach = Vector3.new(0, -1, 0)
	local att = char:FindFirstChild("LeftGripAttachment", true)
	if att then lAttach = att.Position end

	return {
		P = P, tool = tool, R = R, L = L,
		rW = {C0 = CFrame.new()}, lW = {C0 = CFrame.new()},
		base = base, gripWeld = gripWeld,
		rAttach = gripWeld.C0, lAttach = lAttach,
	}
end

local function startR15Pose(char, tool, ctx)
	local function apply()
		applyArms(ctx)
		ctx.R.shoulder.Transform = ctx.R.shoulder.C0:Inverse() * ctx.rW.C0
		ctx.L.shoulder.Transform = ctx.L.shoulder.C0:Inverse() * ctx.lW.C0
		for _, m in ipairs(ctx.R.chain) do m.Transform = CFrame.new() end
		for _, m in ipairs(ctx.L.chain) do m.Transform = CFrame.new() end
	end

	local function step()
		if tool.Parent ~= char then return end
		local gw = char:FindFirstChild("RightGrip", true)
		if gw then ctx.gripWeld = gw end
		pcall(apply)
	end

	local conns = {
		RunService.RenderStepped:Connect(function()
			step()
			local hum = char:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			if animator then
				for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
					if tr.Name:lower():find("tool") then tr:Stop(0) end
				end
			end
		end),
		RunService.Stepped:Connect(step),
		RunService.Heartbeat:Connect(step),
	}

	return function()
		for _, c in ipairs(conns) do c:Disconnect() end
		pcall(function()
			ctx.R.shoulder.Transform = CFrame.new()
			ctx.L.shoulder.Transform = CFrame.new()
		end)
	end
end

local function hookTool(tool)
	local resetWeapon = setupWeapon(tool)

	tool.Equipped:Connect(function()
		local char = tool.Parent
		if not (char and char:IsA("Model")) then return end
		release()

		local P = PROFILES[rigOf(char)]
		local isR15 = rigOf(char) == "R15"

		task.spawn(function()
			local ctx, why
			stats.arm = "equipped, taking over..."; debugUpdate(true)
			local t0 = os.clock()
			while os.clock() - t0 < 8 do
				if tool.Parent ~= char then return end
				if isR15 then
					ctx, why = buildCtxR15(char, tool, P)
				else
					ctx, why = buildCtx(char, tool, P)
				end
				if ctx then break end
				task.wait(0.2)
			end
			if not ctx then
				stats.arm = "FAILED: " .. tostring(why); debugUpdate(true)
				return
			end
			stats.arm = "ok (" .. rigOf(char) .. ")"; debugUpdate(true)

			if isR15 then
				maintainClean = startR15Pose(char, tool, ctx)
				return
			end

			applyArms(ctx)
			local lastScan = 0
			local conn = RunService.RenderStepped:Connect(function()
				if tool.Parent ~= char then return end

				local nowT = os.clock()
				if nowT - lastScan > 0.15 then
					lastScan = nowT
					local armParts = {}
					for _, a in ipairs(active) do
						if a.part1 then armParts[a.part1] = true end
					end
					for _, d in ipairs(char:GetDescendants()) do
						if d:IsA("Motor6D") and d.Part1 and armParts[d.Part1] then
							table.insert(active, {motor = d, part1 = d.Part1})
							d.Part1 = nil
							stats.resets += 1
						end
					end
				end

				for _, a in ipairs(active) do
					if a.motor and a.motor.Parent and a.motor.Part1 ~= nil then
						a.motor.Part1 = nil
						stats.resets += 1
					end
					if a.weld and a.motor and a.motor.Part0 and a.weld.Parent ~= a.motor.Part0 then
						a.weld.Parent = a.motor.Part0
					end
				end

				local gw = char:FindFirstChild("RightGrip", true)
				if gw then ctx.gripWeld = gw end
				pcall(applyArms, ctx)

				local hum = char:FindFirstChildOfClass("Humanoid")
				local animator = hum and hum:FindFirstChildOfClass("Animator")
				if animator then
					for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
						if tr.Name:lower():find("tool") then tr:Stop(0) end
					end
				end
			end)
			maintainClean = function() conn:Disconnect() end
		end)
	end)

	tool.Unequipped:Connect(function()
		release()
		resetWeapon()
	end)
end

local function give()
	local backpack = LocalPlayer:WaitForChild("Backpack")
	local char = LocalPlayer.Character
	if backpack:FindFirstChild(TOOL_NAME) or (char and char:FindFirstChild(TOOL_NAME)) then return end
	local tool = buildTool()
	hookTool(tool)
	tool.Parent = backpack
end

