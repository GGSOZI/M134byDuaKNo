local function impactEffect(result)
	local now = os.clock()
	if now - lastImpact < IMPACT_MIN_GAP then return end
	lastImpact = now

	local pos, normal = result.Position, result.Normal
	local hit = result.Instance
	local mat = result.Material
	local surfColor = hit and hit.Color or Color3.fromRGB(150, 150, 150)
	local onChar = hit and isCharacterPart(hit)
	local metal = METAL[mat]
	local soft = SOFT[mat]

	local surf = CFrame.lookAt(pos, pos + normal)

	local core = newFx(Vector3.new(0.3, 0.3, 0.3), Color3.fromRGB(255, 250, 220), Enum.PartType.Ball)
	core.CFrame = CFrame.new(pos + normal * 0.1)
	core.Parent = bulletFolder
	TweenService:Create(core, TweenInfo.new(0.09, Enum.EasingStyle.Quad), {Size = Vector3.new(1.3, 1.3, 1.3), Transparency = 1}):Play()
	Debris:AddItem(core, 0.15)

	local glow = newFx(Vector3.new(0.5, 0.5, 0.5), BULLET_COLOR, Enum.PartType.Ball)
	glow.Transparency = 0.35
	glow.CFrame = CFrame.new(pos + normal * 0.15)
	glow.Parent = bulletFolder
	TweenService:Create(glow, TweenInfo.new(0.16, Enum.EasingStyle.Quad), {Size = Vector3.new(2.4, 2.4, 2.4), Transparency = 1}):Play()
	Debris:AddItem(glow, 0.2)

	local ring = newFx(Vector3.new(0.04, 0.4, 0.4), Color3.fromRGB(255, 190, 90), Enum.PartType.Cylinder)
	ring.Transparency = 0.2
	ring.CFrame = surf * CFrame.new(0, 0, -0.03) * CFrame.Angles(0, math.rad(90), 0)
	ring.Parent = bulletFolder
	TweenService:Create(ring, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = Vector3.new(0.04, 4, 4), Transparency = 1}):Play()
	Debris:AddItem(ring, 0.3)

	local nSparks = onChar and 5 or (metal and 12 or 8)
	for _ = 1, nSparks do
		local s = newFx(Vector3.new(0.07, 0.07, 0.4), Color3.fromRGB(255, math.random(170, 235), math.random(60, 140)))
		local dir = (normal + Vector3.new(rand(-1, 1), rand(-0.6, 1), rand(-1, 1)) * 0.9).Unit
		throwPiece(s, pos + normal * 0.1, dir * rand(18, metal and 46 or 32), rand(0.3, metal and 0.7 or 0.5), 70, true)
	end

	if not onChar then
		for _ = 1, (soft and 6 or 4) do
			local sz = rand(0.08, soft and 0.22 or 0.15)
			local c = newFx(Vector3.new(sz, sz, sz * rand(0.6, 1.2)), surfColor:Lerp(Color3.new(0, 0, 0), rand(0, 0.35)), nil, Enum.Material.SmoothPlastic)
			local dir = (normal + Vector3.new(rand(-1, 1), rand(-0.3, 1), rand(-1, 1)) * 0.8).Unit
			throwPiece(c, pos + normal * 0.1, dir * rand(8, 22), rand(0.5, 1), 55, false,
				Vector3.new(rand(-12, 12), rand(-12, 12), rand(-12, 12)))
		end

		for _ = 1, 2 do
			local puff = newFx(Vector3.new(0.3, 0.3, 0.3), surfColor:Lerp(Color3.fromRGB(180, 180, 180), 0.6), Enum.PartType.Ball, Enum.Material.SmoothPlastic)
			puff.Transparency = 0.55
			puff.CFrame = CFrame.new(pos + normal * 0.2 + Vector3.new(rand(-0.3, 0.3), rand(-0.3, 0.3), rand(-0.3, 0.3)))
			puff.Parent = bulletFolder
			local life = rand(0.6, 1)
			local sz = rand(1.4, soft and 3 or 2.2)
			TweenService:Create(puff, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = Vector3.new(sz, sz, sz),
				Transparency = 1,
				Position = puff.Position + normal * rand(0.5, 1.2) + Vector3.new(0, rand(0.6, 1.4), 0),
			}):Play()
			Debris:AddItem(puff, life + 0.1)
		end
	end

	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(255, 190, 90)
	pl.Range = 8
	pl.Brightness = 3
	pl.Parent = core
	TweenService:Create(pl, TweenInfo.new(0.1), {Brightness = 0}):Play()

	if hit and not onChar then
		local ok, err = pcall(makeHole, result)
		if not ok then warn("[M134] bullet hole failed: " .. tostring(err)) end
	end
end

local function spawnBullet(origin, dir, params)
	local part = Instance.new("Part")
	part.Name = "Bullet"
	part.Size = Vector3.new(0.35, 0.35, 4)
	part.Material = Enum.Material.Neon
	part.Color = BULLET_COLOR
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.CFrame = CFrame.lookAt(origin, origin + dir)

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.17, 2)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.17, 2)
	a1.Parent = part
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Lifetime = 0.25
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 240, 180), BULLET_COLOR)
	trail.Transparency = fade(0.2, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Parent = part

	part.Parent = bulletFolder
	table.insert(bullets, {part = part, pos = origin, dir = dir, life = BULLET_LIFETIME, params = params})
end

RunService.Heartbeat:Connect(function(dt)
	for i = #bullets, 1, -1 do
		local b = bullets[i]
		b.life -= dt
		local step = b.dir * (BULLET_SPEED * dt)
		local result = workspace:Raycast(b.pos, step, b.params)
		if result then
			local ok, err = pcall(impactEffect, result)
			if not ok then warn("[M134] impact effect error: " .. tostring(err)) end
			b.part:Destroy()
			table.remove(bullets, i)
		elseif b.life <= 0 then
			b.part:Destroy()
			table.remove(bullets, i)
		else
			b.pos += step
			b.part.CFrame = CFrame.lookAt(b.pos, b.pos + b.dir)
		end
	end
end)

